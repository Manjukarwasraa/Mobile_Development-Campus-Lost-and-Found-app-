<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F8FC">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<ImageView android:id="@+id/detailImage" android:layout_width="match_parent" android:layout_height="200dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" />
<TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:textSize="25sp" android:textStyle="bold" android:textColor="#172B4D" />
<TextView android:id="@+id/detailType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textStyle="bold" />
<TextView android:id="@+id/detailCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
<TextView android:id="@+id/detailDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
<TextView android:id="@+id/detailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textStyle="bold" />
<TextView android:id="@+id/detailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:textSize="16sp" />
<Button android:id="@+id/btnResolve" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" />
<Button android:id="@+id/btnCall" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Call" />
<Button android:id="@+id/btnEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Email" />
<Button android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Share" />
<Button android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Delete" />
</LinearLayout>
</ScrollView>
