<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F8FC">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Post an Item" android:textSize="27sp" android:textStyle="bold" android:textColor="#172B4D" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Help your campus community find it." android:textSize="14sp" android:textColor="#6B7280" />
<RadioGroup android:id="@+id/radioType" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
<RadioButton android:id="@+id/radioLost" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lost" android:checked="true" />
<RadioButton android:id="@+id/radioFound" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Found" />
</RadioGroup>
<Spinner android:id="@+id/spinnerCategory" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" />
<EditText android:id="@+id/edtTitle" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:hint="Item title" android:inputType="textCapSentences" />
<EditText android:id="@+id/edtDescription" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="10dp" android:gravity="top" android:hint="Description" android:inputType="textMultiLine" />
<EditText android:id="@+id/edtDate" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:hint="Date" android:focusable="false" />
<EditText android:id="@+id/edtPhone" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:hint="Phone number" android:inputType="phone" />
<EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:hint="Email" android:inputType="textEmailAddress" />
<ImageView android:id="@+id/imagePreview" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_menu_gallery" />
<Button android:id="@+id/btnChooseImage" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Choose Image" />
<Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="10dp" android:text="Save Item" />
</LinearLayout>
</ScrollView>
