<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F7F8FC">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campus Items" android:textSize="27sp" android:textStyle="bold" android:textColor="#172B4D" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Browse lost, found and resolved items" android:textSize="14sp" android:textColor="#6B7280" android:layout_marginTop="4dp" />
<Spinner android:id="@+id/spinnerFilter" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" />
<TextView android:id="@+id/txtQueryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:text="No items found" android:textColor="#777777" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerQueries" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" />
</LinearLayout>
